# ============================================================
# WebDuLich — Environment variables mẫu
# Copy file này thành .env và điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env thật lên git.
# ============================================================

# --- Database ---
# Dev local (SQLite): true | Production (PostgreSQL): false
USE_LOCAL_DB=true

# Production: Railway tự inject DATABASE_URL — ưu tiên cao nhất.
# Nếu không có DATABASE_URL, đặt thủ công các biến PG* bên dưới.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGDATABASE=railway
# PGUSER=postgres
# PGPASSWORD=change-me
# PGHOST=containers-us-west-1.railway.app
# PGPORT=6543

# --- Django ---
# Bắt buộc đặt ở production. Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production
# Bắt buộc đặt ở production (ví dụ: yourapp.up.railway.app,localhost)
ALLOWED_HOSTS=localhost,127.0.0.1
# Đặt "false" cho production
DJANGO_DEBUG=true

# --- OpenWeatherMap (https://openweathermap.org/api — key miễn phí) ---
OPENWEATHERMAP_API_KEY=

# --- Meilisearch Cloud (https://cloud.meilisearch.com — search engine) ---
# Tạo project (free tier) → lấy "Meilisearch URL" và API key. Dùng Admin
# API Key vì server cần quyền index (không chỉ search). Để trống cả 2
# → web tự dùng ORM search làm fallback, mọi thứ vẫn chạy bình thường.
# Sau khi điền, chạy lần đầu: python manage.py reindex_meili
MEILI_HOST=
MEILI_API_KEY=

# --- Email (Gmail SMTP + App Password: Google Account → Security → App passwords) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Prod-only ---
# All hosts/domain cho phép (vd: yourapp.up.railway.app)
# ALLOWED_HOSTS=yourapp.up.railway.app
# Origin CSRF tin cậy (vd: https://yourapp.up.railway.app)
# CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app
# Path admin tuỳ biến chống scan bot (vd: quan-tri-x9k2/)
# ADMIN_URL_PATH=admin/
# Bật khi chạy sau proxy mình kiểm soát (Railway/nginx) để dùng IP thật từ XFF
# TRUST_X_FORWARDED_FOR=true
# SECURE_SSL_REDIRECT=true
# (đa worker) Redis cache backend — LocMemCache không chia sẻ giữa worker
# REDIS_URL=redis://...
